.venv/
__pycache__/
*.pyc
.pytest_cache/
*_preview.html
xs*.png
.DS_Store

# vive-check/vive-interviewの成果物置き場（preview/trace/dose/maps/requirements）。
# 残す価値のあるものはdocs/egs5_crosscheck/<name>/等へ意図的にコピーして追跡する。
runs/

# EGS5本体（KEK配布、Stanford/SLACライセンスの第三者コード）はリポジトリに含めない。
# 自作の差分（docs/egs5_crosscheck/water60_free/, water60_bound/）とRESULTS.mdのみ追跡する。
docs/egs5_crosscheck/egs5/
docs/egs5_crosscheck/egs5.241010.tar.gz

# 治療領域拡張の試作: 再生成できる大きな数値ファイルは追跡しない
docs/validation/mv/p1/**/*.npz
docs/validation/mv/p1b/**/*.npz
docs/validation/mv/p1b/initial_numerical_trials/

# 絶対パスを含む実行ログは追跡しない（手元には残す。manifestのハッシュは手元のファイルと照合する）
docs/validation/mv/p0/regression_test.log
docs/validation/mv/p1/regression_tests.log
docs/validation/mv/p1/regression_tests_final.log
docs/validation/mv/p1b/prototype_tests_initial.log
docs/validation/mv/p1b/regression_tests.log
docs/validation/mv/p1b/regression_tests_final.log
docs/validation/mv/p1b/replay_initial.log

# P1c regenerable numerical artifacts
docs/validation/mv/p1c/**/*.npz

# P1d regenerable numerical artifacts
docs/validation/mv/p1d/**/*.npz

# P1e regenerable run artifacts; ELSEPA generated tables stay external
docs/validation/mv/p1e/**/*.npz
prototypes/mv_electron/**/elsepa*.npz
prototypes/mv_electron/**/z[18]_q*.npz

# P1e/P1f regenerable numerical artifacts
docs/validation/mv/p1e/**/*.npz
docs/validation/mv/p1f/**/*.npz

# P2 regenerated arrays; external reference programs/data are never stored here.
docs/validation/mv/p2/**/*.npz
docs/validation/mv/p2/**/*.raw.log

# P2b–P3s regenerable numerical artifacts and leftovers of interrupted checks
docs/validation/mv/p2b/**/*.npz
docs/validation/mv/p2b/**/*.npy
docs/validation/mv/p2c/**/*.npz
docs/validation/mv/p3a/**/*.npz
docs/validation/mv/p3a/**/*.npy
docs/validation/mv/p3s/**/*.npz
docs/validation/mv/p3r/**/*.npz
docs/validation/mv/**/*.tmp

# P3b: 再生成できる大きな数値ファイルは追跡しない（EGS5の result.npz には線源のエネルギーを数えた配列があり、
# 履歴数が多いと未追跡のスペクトルの写しに近くなる）。解析の全出力は手元に残し、要点は analysis_p3b3_summary.json を追跡する
docs/validation/mv/p3b/**/*.npz
docs/validation/mv/p3b/analysis_p3b3.json
# P4の結果のnpzも追跡しない（計算の出力は ~/.cache/chatcarlo/p4/ に置く。スペクトルを使った出力を含む）
docs/validation/mv/p4/**/*.npz

# P5a0: build products and the input bundle (not tracked)
.p5a0_work/
# P5 result JSON files are large (values of the first 10,000 points); kept outside git
docs/validation/mv/p5/*.json
docs/validation/mv/p8a/checks_progress.json

# JSMP133 Supporting Data: 学会配布のテンプレートとガイドライン（再配布しない）
docs/jsmp133/supporting_data/

# Git管理領域を肥大化させる計算出力はローカルで保全する
/data/
